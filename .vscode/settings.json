      "Oxc",
      "oxlint",
      "oxfmt",
      "Lefthook",
      "Commitlint",
      "SonarQube",
      "Monaspace",
      "Datadog",
      "Antigravity",
      "Codex",
      "LuaLaTeX"
    ],
    "es": [
      "Nathalie",
      "Zambrano",
      "Molero",
      "Maracaibo",
      "Urdaneta",
      "Chacín",
      "Chicks",
      "CreaApps",
      "BINWUS",
      "NgRx",
      "Taiga",
      "Graphr",
      "Lumi",
      "Oxc",
      "oxlint",
      "oxfmt",
      "Lefthook",
      "Commitlint",
      "SonarQube",
      "Monaspace",
      "Datadog",
      "Antigravity",
      "Codex",
      "LuaLaTeX",
      "hotfixes",
      "monorepo",
      "wireframes",
      "drag-and-drop",
      "stakeholders",
      "dailies",
