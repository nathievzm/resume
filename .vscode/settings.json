      "DevEx"
    ]
  },

  // latex workshop: compile with lualatex from src/ (single default or en/es outputs)
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "-interaction=nonstopmode",
        "-halt-on-error",
        "%DOC%"
      ]
    },
    {
      "name": "lualatex-en",
      "command": "lualatex",
      "args": [
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-jobname=resume-en",
        "\\def\\ResumeLang{en}\\input{%DOCFILE%}"
      ]
    },
    {
      "name": "lualatex-es",
      "command": "lualatex",
      "args": [
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-jobname=resume-es",
        "\\def\\ResumeLang{es}\\input{%DOCFILE%}"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX",
      "tools": ["lualatex", "lualatex"]
    },
    {
      "name": "LuaLaTeX (EN)",
      "tools": ["lualatex-en", "lualatex-en"]
    },
    {
      "name": "LuaLaTeX (ES)",
      "tools": ["lualatex-es", "lualatex-es"]
    },
    {
      "name": "LuaLaTeX (EN + ES)",
      "tools": ["lualatex-en", "lualatex-en", "lualatex-es", "lualatex-es"]
    }
  ],
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.fdb_latexmk",
    "*.fls",
    "*.log",
    "*.out",
    "*.synctex.gz",
    "*.toc",
    "*.xdv"
  ]
}
